<% layout("/layouts/boilerplate") %>

<body>
    
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>MAKE CHANGES</h3>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation">
        <div >
            <label for=" title" class="form-label">Title</label>
            <input type="text" class="form-control" placeholder="Enter title name" name="listing[title]" required value="<%=listing.title%>">
            <div class="invalid-feedback">Title is invalid</div>

        </div>
    <br>
    <div >
        <label for="description" class="form-label">Description</label>
    <textarea placeholder="Describe about place" class="form-control" name="listing[description]" required>"<%=listing.description%>"</textarea>
        <div class="invalid-feedback">Please enter a short description</div>

    </div>
    <br>
    <div class="row" >
        <div class="col-md-4">
        <label for=" price" class="form-label">Price</label>
            <input type="number" class="form-control" required name="listing[price]" value="<%=listing.price%>"">
            <div class="invalid-feedback">URL/link is required</div>

    </div>
     <div class="col-md-8">
        <label for="country" class="form-label">Country</label>
    <input type="text" class="form-control" required name="listing[country]" placeholder="Enter Country" value="<%=listing.country%>">
        <div class="invalid-feedback">Country is required</div>
</div>
    <br>
    </div>
    
  
    <div >
        <label for="location " class="form-label">Location</label>
            <input type="text" class="form-control" required name="listing[location]" placeholder="Where is it located?" value="<%=listing.location%>">
        <div class="invalid-feedback">Location is required</div>

    </div>
    
   
   
    <button class="btn btn-dark edit-btn mt-3">EDIT</button>
    </form>

    </div>
    </div>
</body>
