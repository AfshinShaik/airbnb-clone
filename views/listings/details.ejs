<% layout("/layouts/boilerplate") %>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3><%=listing.title%></h3>
            <div class="card listing-card">
             <img src="<%= listing.image.url %>" class="card-img-top detail-img" alt="listing-image" style="height: 20rem;">
  <div class="card-img-overlay"></div>   
            </div>
            <div class="card-body">
                <p>
            <%=listing.description%><br>
            &#8377; <%=listing.price.toLocaleString("en-IN")%><br>
            <%=listing.location%><br>
            <%=listing.country%>
        </p>
            </div>
        
    
    <div class="btns">
    <a href="/listings/<%=listing._id%>/edit"><button class="btn btn-dark edit-btn ">
        Edit
    </button></a>
    <br><br>
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark offset-4">Delete</button>
    </form>
    </div>
    </div>
    </div>

    <div class="col-8 offset-2 mt-3 mb-3">
        <hr>
        <h4>Share your Experience</h4>
        <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mt-3 mb-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" class="form-range" id="rating" name="review[rating]">
            </div>
            <div class="mt-3 mb-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" col="70" row="5" class="form-control" required></textarea>
                <div class="invalid-feedback">Please fill comment.</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>


        <p><b>Reviews</b></p>
        <div class="row">

            <% for(let review of listing.reviews) { %>
                <div class="card col-5 mt-3 ms-3"> 
                    <div class="card-body">
                        <div class="card-title">Joseph</div>
                        <div class="card-text"><%= review.comment %></div>
                        <div class="card-text"><%= review.rating %> Stars</div>
                        <form method="POST" class="mt-3 mb-3" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-dark btn-sm">Delete</button>
                        </form>
                    </div> </div>
                <% } %>
        </div>
    </div>
</body>
